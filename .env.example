# Copy to .env and adjust. All variables are optional.

# Port on your machine (the container always listens on 3313 inside).
CONBERT_PORT=3313

# fatal | error | warn | info | debug | trace | silent
CONBERT_LOG_LEVEL=info

# Largest file you can upload to the server, in MB.
CONBERT_MAX_UPLOAD_MB=2048

# Uploaded files and results are deleted this many minutes after the job ends.
CONBERT_CLEANUP_MINUTES=60

# --- Resource limits -------------------------------------------------------
# How many server jobs run at the same time. More is faster on strong
# machines but needs more memory (a 4K video can take 1–2 GB).
# CONBERT_JOB_CONCURRENCY=2
# Most memory the container may use, e.g. 4g or 2048m (0 = no limit). On a
# small NAS, 2g–4g keeps the rest of the system responsive. If a conversion
# needs more, it fails with a clear message instead of freezing the NAS.
# CONBERT_MEMORY_LIMIT=4g
# Most CPU cores the container may use, e.g. 2 or 1.5 (0 = no limit).
# Converters already run at a lower priority than everything else.
# CONBERT_CPUS=2
# Most processes and threads at once (stops runaway programs).
# CONBERT_PIDS_LIMIT=4096

# User and group Conbert runs as (default 1000:1000). On start, Conbert hands
# its data folder to them. Unraid and many NAS keep shares as nobody:users –
# there use PUID=99 and PGID=100. Folders you mount below /storage must be
# writable for this user, too.
# PUID=1000
# PGID=1000

# First start: a random setup code is printed to the log. Set your own here
# if you prefer (at least 8 characters).
# CONBERT_SETUP_CODE=

# Login via your reverse proxy (Authelia, Authentik, oauth2-proxy …).
# Both values are needed; requests from other addresses ignore the header.
# CONBERT_AUTH_PROXY_HEADER=Remote-User
# CONBERT_TRUSTED_PROXIES=172.18.0.1,10.0.0.0/8
# Optional: header with the user's groups (Authelia: Remote-Groups,
# Authentik: X-authentik-groups). Groups are matched by the "group name at the
# reverse proxy" you enter per group in Conbert's administration.
# CONBERT_PROXY_GROUPS_HEADER=Remote-Groups

# Which image to download: "latest" (default), "full" (adds Calibre for
# e-books like MOBI, AZW3, FB2; about 850 MB larger) or a fixed version such
# as "0.1.0" or "0.1.0-full". Apply with: docker compose pull && docker compose up -d
# CONBERT_IMAGE_TAG=full

# Only when you build the image yourself (docker-compose.build.yml):
# "standard" or "full", same meaning as above.
# CONBERT_EDITION=full

# Key that encrypts the passwords of your storage locations (NAS, SFTP …).
# Without it, Conbert creates a random key in its data volume on first start –
# that works, but then key and passwords are stored side by side. Set your own
# (at least 16 characters), e.g. from: openssl rand -base64 32
# Keep it safe: if it changes, stored passwords must be entered again.
# CONBERT_SECRET=
