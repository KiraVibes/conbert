{
  "name": "conbert",
  "version": "0.1.3",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "description": "Conbert – FileWizard: self-hosted file converter and compressor",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --recursive run build",
    "start": "pnpm --filter @conbert/server run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @conbert/web run test:e2e",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:docker": "docker build -f apps/server/Dockerfile --target test --build-arg TOOLS_STAGE=tools-full -t conbert-test . && docker run --rm conbert-test",
    "docs:tools": "node scripts/tools-doc.mjs && prettier --write docs/werkzeuge.md docs/en/tools.md"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
