{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM types for callbacks that Playwright runs inside the page.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    // vite.config.ts imports its helper with ".ts" (Vite's native config loader needs it).
    "allowImportingTsExtensions": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "scripts", "e2e"]
}
